{
  "name": "acme",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "elysia": "^1.4.30",
      "@elysia/eden": "^1.4.10",
      "@elysia/openapi": "^1.4.16",
      "@sinclair/typebox": "0.34.52",
      "drizzle-orm": "^0.45.3",
      "drizzle-kit": "^0.31.11",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.2"
    }
  },
  "scripts": {
    "dev": "bun run --filter '@acme/api' --filter '@acme/web' dev",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "bun test --parallel",
    "audit": "bun audit --audit-level=high",
    "check": "bun run lint && bun run typecheck && bun run audit && bun run test"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/bun": "catalog:",
    "@biomejs/biome": "^2.5.14"
  },
  "overrides": {
    "@sinclair/typebox": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
